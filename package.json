{
  "name": "jindalwebapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "backfill-embeddings": "node --env-file=.env.local scripts/backfill-embeddings.mjs",
    "backfill-attributes": "node --experimental-strip-types --env-file=.env.local scripts/backfill-attributes.ts"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@neondatabase/serverless": "^1.1.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.4",
    "papaparse": "^5.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
